<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <groupId>org.eclipse.esmf</groupId>
   <artifactId>test-generate-sql-mojo</artifactId>
   <version>1.0</version>
   <packaging>jar</packaging>
   <name>Test Generate SQL Mojo</name>

   <build>
      <plugins>
         <plugin>
            <artifactId>esmf-aspect-model-maven-plugin</artifactId>
            <configuration>
               <modelsRootDirectory>${basedir}/../../core/esmf-test-aspect-models/src/main/resources/valid</modelsRootDirectory>
               <includes>
                  <include>urn:samm:org.eclipse.esmf.test:1.0.0#AspectWithEntity</include>
               </includes>
               <tableCommandPrefix>CREATE TABLE</tableCommandPrefix>
               <strategy>normalized</strategy>
               <customColumnsForTable>
                  <aspect_with_entity>custom_column1 ARRAY&lt;STRING&gt; NOT NULL COMMENT 'Custom column';custom_column2 INT</aspect_with_entity>
                  <test_entity>custom_column3 INT</test_entity>
               </customColumnsForTable>
               <constraintsForTable>
                  <aspect_with_entity>PRIMARY KEY (string_property)</aspect_with_entity>
                  <test_entity>CHECK (entity_property &lt;&gt; 'invalid')</test_entity>
               </constraintsForTable>
               <outputDirectory>${basedir}/target/test-artifacts</outputDirectory>
            </configuration>
         </plugin>
      </plugins>
   </build>
</project>
