@prefix : <urn:samm:org.eclipse.esmf.test:1.0.0#> .
@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .

:AspectWithDataTypes a samm:Aspect ;
   samm:preferredName "Test Aspect"@en ;
   samm:description "This is a test description"@en ;
   samm:see <http://example.com/> ;
   samm:properties ( :decimalDurationWithoutUnitProperty :decimalDurationWithUnitProperty :floatEnumerationProperty
      :floatQuantifiableWithUnitProperty :floatQuantifiableWithoutUnitProperty
      :decimalMeasureWithUnitProperty :decimalMeasureWithoutUnitProperty ) ;
   samm:operations ( ) .

:decimalDurationWithoutUnitProperty a samm:Property ;
   samm:characteristic :DecimalDurationWithoutUnit .

:DecimalDurationWithoutUnit a samm-c:Duration ;
   samm:dataType xsd:decimal .

:decimalDurationWithUnitProperty a samm:Property ;
   samm:characteristic :DecimalDurationWithUnit .

:DecimalDurationWithUnit a samm-c:Duration ;
   samm:dataType xsd:decimal ;
   samm-c:unit unit:kilosecond .

:floatEnumerationProperty a samm:Property ;
   samm:characteristic :FloatEnumeration .

:FloatEnumeration a samm-c:Enumeration ;
   samm:dataType xsd:float ;
   samm-c:values ( 1.5 2.5 3.5 ) .

:floatQuantifiableWithUnitProperty a samm:Property ;
   samm:characteristic :FloatQuantifiableWithUnit .

:FloatQuantifiableWithUnit a samm-c:Quantifiable ;
   samm-c:unit unit:percent ;
   samm:dataType xsd:float .

:floatQuantifiableWithoutUnitProperty a samm:Property ;
   samm:characteristic :FloatQuantifiableWithoutUnit .

:FloatQuantifiableWithoutUnit a samm-c:Quantifiable ;
   samm:dataType xsd:float .

:decimalMeasureWithUnitProperty a samm:Property ;
   samm:characteristic :DecimalMeasureWithUnit .

:DecimalMeasureWithUnit a samm-c:Measurement ;
   samm-c:unit unit:percent ;
   samm:dataType xsd:decimal .

:decimalMeasureWithoutUnitProperty a samm:Property ;
   samm:characteristic :DecimalMeasureWithoutUnit .

:DecimalMeasureWithoutUnit a samm-c:Measurement ;
   samm:dataType xsd:decimal .
