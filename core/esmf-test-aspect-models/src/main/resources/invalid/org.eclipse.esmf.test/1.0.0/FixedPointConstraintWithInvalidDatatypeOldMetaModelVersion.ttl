@prefix : <urn:samm:org.eclipse.esmf.test:1.0.0#> .
@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.1.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.1.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.1.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Uses SAMM 2.1.0 on purpose, so that the model is migrated before it is validated.
# The FixedPointConstraint is not applicable to the xsd:float datatype of the base characteristic.
:testProperty a samm:Property ;
   samm:characteristic :TestTrait .

:TestTrait a samm-c:Trait ;
   samm-c:constraint [
      a samm-c:FixedPointConstraint ;
      samm:preferredName "Test Fixed Point Constraint"@en ;
      samm:description "This is a test fixed point constraint"@en ;
      samm:see <http://example.com/> ;
      samm-c:scale "4"^^xsd:positiveInteger ;
      samm-c:integer "2"^^xsd:positiveInteger ;
   ] ;
   samm-c:baseCharacteristic :Measurement .

:Measurement a samm-c:Measurement ;
   samm:dataType xsd:float ;
   samm-c:unit unit:metrePerSecond .
