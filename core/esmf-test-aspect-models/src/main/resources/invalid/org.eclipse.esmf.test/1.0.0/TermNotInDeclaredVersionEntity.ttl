@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.1.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.1.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.1.0#> .
@prefix : <urn:samm:org.eclipse.esmf.test:1.0.0#> .

:TermNotInDeclaredVersionEntity a samm:Aspect ;
   samm:properties ( :testProperty ) ;
   samm:operations ( ) ;
   samm:events ( ) .

:testProperty a samm:Property ;
   samm:characteristic :TestCharacteristic .

# samm-e:Quantity was introduced in SAMM 2.2.0 and does not exist in the declared version 2.1.0
:TestCharacteristic a samm-c:SingleEntity ;
   samm:preferredName "Test Characteristic"@en ;
   samm:dataType samm-e:Quantity .
