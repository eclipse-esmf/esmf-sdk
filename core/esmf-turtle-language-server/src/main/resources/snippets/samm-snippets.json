      "   {{sammCPrefix}}minValue \"${2:0}\"^^{{xsdPrefix}}nonNegativeInteger ;",
      "   {{sammCPrefix}}maxValue \"${3:10}\"^^{{xsdPrefix}}nonNegativeInteger .$0"
