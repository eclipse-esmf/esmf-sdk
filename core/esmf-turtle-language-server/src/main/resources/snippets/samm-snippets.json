[
  {
    "id": "samm-prefixes",
    "label": "SAMM Prefix Header",
    "localName": "prefix",
    "targetPosition": "DOCUMENT_HEADER",
    "body": [
      "@prefix : <urn:samm:${1:com.example.namespace}:${2:1.0.0}#> .",
      "@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:${3:{{sammVersion}}}#> .",
      "@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:${3:{{sammVersion}}}#> .",
      "@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:${3:{{sammVersion}}}#> .",
      "@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:${3:{{sammVersion}}}#> .",
      "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .",
      "@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .",
      "",
      "$0"
    ]
  },
  {
    "id": "samm-aspect",
    "label": "SAMM Aspect",
    "localName": "Aspect",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:AspectName} a {{sammPrefix}}Aspect ;",
      "   {{sammPrefix}}preferredName \"${2}\"@en ;",
      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}properties ( {{modelPrefix}}${4:property} ) ;",
      "   {{sammPrefix}}operations ( ) ;",
      "   {{sammPrefix}}events ( ) .$0"
    ]
  },
  {
    "id": "samm-property",
    "label": "SAMM Property",
    "localName": "Property",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:propertyName} a {{sammPrefix}}Property ;",
      "   {{sammPrefix}}preferredName \"${2}\"@en ;",
      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}characteristic {{modelPrefix}}${4:CharacteristicName} .$0"
    ]
  },
  {
    "id": "samm-abstract-property",
