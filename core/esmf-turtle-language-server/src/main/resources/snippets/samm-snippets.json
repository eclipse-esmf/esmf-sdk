  {
    "id": "samm-c-fixed-point-constraint",
    "label": "SAMM FixedPointConstraint",
    "localName": "FixedPointConstraint",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ConstraintName} a {{sammCPrefix}}FixedPointConstraint ;",
      "   {{sammCPrefix}}scale \"${2:2}\"^^{{xsdPrefix}}positiveInteger ;",
      "   {{sammCPrefix}}integer \"${3:5}\"^^{{xsdPrefix}}positiveInteger .$0"
    ]
  },
  {
    "id": "samm-operation",
    "label": "SAMM Operation",
    "localName": "Operation",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
