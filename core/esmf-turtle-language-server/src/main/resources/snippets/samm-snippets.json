      "   {{sammCPrefix}}values ( ${5:\"value1\" \"value2\"} ) .$0"
    ]
  },
  {
    "id": "samm-c-state",
    "label": "SAMM State",
    "defaultFilterText": "State",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
