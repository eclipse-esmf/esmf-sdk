    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ConstraintName} a {{sammCPrefix}}LocaleConstraint ;",
      "   {{sammCPrefix}}localeCode \"${2:de-DE}\" .$0"
    ]
  },
  {
