      "   {{sammPrefix}}preferredName \"${2}\"@en ;",
      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}dataType ${4|{{allDataTypes}}|} ;",
      "   {{sammCPrefix}}values ( ${5} ) .$0"
    ]
  },
  {
    "id": "samm-c-state",
    "label": "SAMM State",
    "localName": "State",
    "targetPosition": "TOP_LEVEL_SUBJECT",
