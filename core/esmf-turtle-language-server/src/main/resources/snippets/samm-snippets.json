      "   {{sammPrefix}}dataType ${4|{{numericDataTypes}}|} ;",
      "   {{sammCPrefix}}unit {{unitPrefix}}${5:kilometrePerHour} .$0"
    ]
  },
  {
    "id": "samm-c-quantifiable",
    "label": "SAMM Quantifiable",
    "localName": "Quantifiable",
    "targetPosition": "TOP_LEVEL_SUBJECT",
