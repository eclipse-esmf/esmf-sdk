  {
    "id": "samm-c-structured-value",
    "label": "SAMM StructuredValue",
    "localName": "StructuredValue",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:StructuredValueName} a {{sammCPrefix}}StructuredValue ;",
      "   {{sammPrefix}}preferredName \"${2}\"@en ;",
      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}dataType {{xsdPrefix}}${4:string} ;",
      "   {{sammCPrefix}}deconstructionRule \"${5:(.*)}\" ;",
      "   {{sammCPrefix}}elements ( {{modelPrefix}}${6:elementProperty} ) .$0"
    ]
  },
  {
    "id": "samm-c-length-constraint",
    "label": "SAMM LengthConstraint",
    "localName": "LengthConstraint",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ConstraintName} a {{sammCPrefix}}LengthConstraint ;",
      "   {{sammCPrefix}}minValue \"${2:0}\"^^{{xsdPrefix}}nonNegativeInteger ;",
      "   {{sammCPrefix}}maxValue \"${3:10}\"^^{{xsdPrefix}}nonNegativeInteger .$0"
    ]
  },
  {
    "id": "samm-c-range-constraint",
    "label": "SAMM RangeConstraint",
    "localName": "RangeConstraint",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ConstraintName} a {{sammCPrefix}}RangeConstraint ;",
      "   {{sammCPrefix}}minValue \"${2:0}\"^^{{xsdPrefix}}${3:float} ;",
      "   {{sammCPrefix}}maxValue \"${4:100}\"^^{{xsdPrefix}}${3:float} ;",
      "   {{sammCPrefix}}lowerBoundDefinition {{sammCPrefix}}${5:AT_LEAST} ;",
      "   {{sammCPrefix}}upperBoundDefinition {{sammCPrefix}}${6:AT_MOST} .$0"
    ]
  },
  {
    "id": "samm-c-regex-constraint",
    "label": "SAMM RegularExpressionConstraint",
    "localName": "RegularExpressionConstraint",
    "keywords": [ "regex" ],
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ConstraintName} a {{sammCPrefix}}RegularExpressionConstraint ;",
      "   {{sammPrefix}}value \"${2:^[A-Z0-9]+$}\" .$0"
    ]
  },
  {
    "id": "samm-c-encoding-constraint",
    "label": "SAMM EncodingConstraint",
    "localName": "EncodingConstraint",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ConstraintName} a {{sammCPrefix}}EncodingConstraint ;",
      "   {{sammPrefix}}value {{sammPrefix}}${2:UTF-8} .$0"
    ]
  },
  {
    "id": "samm-c-language-constraint",
    "label": "SAMM LanguageConstraint",
    "localName": "LanguageConstraint",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ConstraintName} a {{sammCPrefix}}LanguageConstraint ;",
      "   {{sammCPrefix}}languageCode \"${2:en}\" .$0"
    ]
  },
  {
    "id": "samm-c-locale-constraint",
    "label": "SAMM LocaleConstraint",
    "localName": "LocaleConstraint",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
