    "body": [
      "[",
      "   a {{sammCPrefix}}FixedPointConstraint ;",
      "   {{sammCPrefix}}scale \"${1:2}\"^^{{xsdPrefix}}positiveInteger ;",
      "   {{sammCPrefix}}integer \"${2:5}\"^^{{xsdPrefix}}positiveInteger",
      "]$0"
    ]
