      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}dataType ${4|{{numericDataTypes}}|} ;",
      "   {{sammCPrefix}}unit {{unitPrefix}}${5:percent} .$0"
    ]
  },
