      "   a {{sammCPrefix}}RegularExpressionConstraint ;",
      "   {{sammPrefix}}value \"${1:^[A-Z0-9]+$}\"",
      "]$0"
    ]
  },
  {
    "id": "samm-anon-c-encoding-constraint",
    "label": "SAMM Anonymous EncodingConstraint",
    "defaultFilterText": "EncodingConstraint",
    "targetPosition": "OBJECT_CONSTRAINT",
    "body": [
      "[",
      "   a {{sammCPrefix}}EncodingConstraint ;",
      "   {{sammPrefix}}value {{sammPrefix}}${1:UTF-8}",
      "]$0"
    ]
  },
  {
    "id": "samm-anon-c-language-constraint",
    "label": "SAMM Anonymous LanguageConstraint",
    "defaultFilterText": "LanguageConstraint",
    "targetPosition": "OBJECT_CONSTRAINT",
    "body": [
      "[",
      "   a {{sammCPrefix}}LanguageConstraint ;",
      "   {{sammCPrefix}}languageCode \"${1:en}\"",
      "]$0"
    ]
  },
  {
    "id": "samm-anon-c-locale-constraint",
    "label": "SAMM Anonymous LocaleConstraint",
    "defaultFilterText": "LocaleConstraint",
    "targetPosition": "OBJECT_CONSTRAINT",
    "body": [
      "[",
      "   a {{sammCPrefix}}LocaleConstraint ;",
      "   {{sammCPrefix}}localeCode \"${1:de-DE}\"",
      "]$0"
    ]
  },
  {
    "id": "samm-anon-c-fixed-point-constraint",
