      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}input ( {{modelPrefix}}${4:inputProperty} ) ;",
      "   {{sammPrefix}}output {{modelPrefix}}${5:outputProperty} .$0"
    ]
  },
  {
    "id": "samm-event",
    "label": "SAMM Event",
    "defaultFilterText": "Event",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:eventName} a {{sammPrefix}}Event ;",
      "   {{sammPrefix}}preferredName \"${2}\"@en ;",
      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}parameters ( {{modelPrefix}}${4:parameterProperty} ) .$0"
    ]
  },
  {
    "id": "samm-description",
    "label": "SAMM description",
    "defaultFilterText": "description",
    "targetPosition": "PREDICATE",
    "body": [
      "{{sammPrefix}}description \"${1}\"@en{{separator}}"
    ]
  },
  {
    "id": "samm-preferred-name",
    "label": "SAMM preferredName",
    "defaultFilterText": "preferredName",
    "targetPosition": "PREDICATE",
    "body": [
      "{{sammPrefix}}preferredName \"${1}\"@en{{separator}}"
    ]
  },
  {
    "id": "samm-see",
    "label": "SAMM see",
    "defaultFilterText": "see",
    "targetPosition": "PREDICATE",
    "allowMultiple": true,
    "body": [
      "{{sammPrefix}}see <${1:https://example.com/term/}>{{separator}}"
    ]
  },
  {
    "id": "samm-example-value",
    "label": "SAMM exampleValue",
    "defaultFilterText": "exampleValue",
    "targetPosition": "PREDICATE",
    "requiredSubjectTypes": [ "Property" ],
    "body": [
      "{{sammPrefix}}exampleValue \"${1}\"{{separator}}"
    ]
  },
  {
    "id": "samm-anon-property-optional",
    "label": "SAMM Optional Property",
    "defaultFilterText": "optional",
    "targetPosition": "OBJECT_PROPERTIES_LIST",
    "body": [
      "[ {{sammPrefix}}property {{modelPrefix}}${1:propertyName} ; {{sammPrefix}}optional true ]$0"
    ]
  },
  {
    "id": "samm-anon-property-payload-name",
    "label": "SAMM Property with Payload Name",
    "defaultFilterText": "payloadName",
    "targetPosition": "OBJECT_PROPERTIES_LIST",
    "body": [
      "[ {{sammPrefix}}property {{modelPrefix}}${1:propertyName} ; {{sammPrefix}}payloadName \"${2:payloadKey}\" ]$0"
    ]
  },
  {
    "id": "samm-anon-property-not-in-payload",
    "label": "SAMM Property Not In Payload",
    "defaultFilterText": "notInPayload",
    "targetPosition": "OBJECT_PROPERTIES_LIST",
    "requiredSubjectTypes": [ "Entity", "AbstractEntity" ],
    "body": [
      "[ {{sammPrefix}}property {{modelPrefix}}${1:propertyName} ; {{sammPrefix}}notInPayload true ]$0"
    ]
  },
  {
    "id": "samm-anon-property-extends",
    "label": "SAMM Extended AbstractProperty",
    "defaultFilterText": "extends",
    "targetPosition": "OBJECT_PROPERTIES_LIST",
    "requiredSubjectPredicate": "extends",
    "body": [
      "[ {{sammPrefix}}extends {{modelPrefix}}${1:abstractProperty} ; {{sammPrefix}}characteristic {{modelPrefix}}${2:CharacteristicName} ]$0"
    ]
  },
  {
    "id": "samm-anon-c-length-constraint",
    "label": "SAMM Anonymous LengthConstraint",
    "defaultFilterText": "LengthConstraint",
    "targetPosition": "OBJECT_CONSTRAINT",
    "body": [
      "[",
      "   a {{sammCPrefix}}LengthConstraint ;",
      "   {{sammCPrefix}}minValue \"${1:2}\"^^{{xsdPrefix}}nonNegativeInteger ;",
      "   {{sammCPrefix}}maxValue \"${2:2}\"^^{{xsdPrefix}}nonNegativeInteger",
      "]$0"
    ]
  },
  {
    "id": "samm-anon-c-range-constraint",
    "label": "SAMM Anonymous RangeConstraint",
    "defaultFilterText": "RangeConstraint",
    "targetPosition": "OBJECT_CONSTRAINT",
    "body": [
      "[",
      "   a {{sammCPrefix}}RangeConstraint ;",
      "   {{sammCPrefix}}minValue \"${1:0}\"^^{{xsdPrefix}}${2:float} ;",
      "   {{sammCPrefix}}maxValue \"${3:100}\"^^{{xsdPrefix}}${2:float} ;",
      "   {{sammCPrefix}}lowerBoundDefinition {{sammCPrefix}}${4:AT_LEAST} ;",
      "   {{sammCPrefix}}upperBoundDefinition {{sammCPrefix}}${5:AT_MOST}",
