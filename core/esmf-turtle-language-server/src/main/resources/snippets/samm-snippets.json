      "   {{sammPrefix}}dataType ${4|{{allDataTypes}}|} ;",
      "   {{sammCPrefix}}values ( ${5} ) ;",
      "   {{sammCPrefix}}defaultValue ${6} .$0"
    ]
  },
  {
    "id": "samm-value",
    "label": "SAMM Value",
    "localName": "Value",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:ValueName} a {{sammPrefix}}Value ;",
      "   {{sammPrefix}}value \"${2:code}\" ;",
      "   {{sammPrefix}}preferredName \"${3}\"@en ;",
      "   {{sammPrefix}}description \"${4}\"@en .$0"
    ]
  },
  {
    "id": "samm-c-measurement",
