      "   {{sammPrefix}}description \"${3}\"@en ;",
      "   {{sammPrefix}}parameters ( {{modelPrefix}}${4:parameterProperty} ) .$0"
    ]
  },
  {
    "id": "samm-unit",
    "label": "SAMM Unit",
    "localName": "Unit",
    "targetPosition": "TOP_LEVEL_SUBJECT",
    "body": [
      "{{modelPrefix}}${1:unitName} a {{sammPrefix}}Unit ;",
      "   {{sammPrefix}}preferredName \"${2}\"@en ;",
      "   {{sammPrefix}}symbol \"${3}\" ;",
      "   {{sammPrefix}}referenceUnit {{unitPrefix}}${4:metre} ;",
      "   {{sammPrefix}}conversionFactor \"${5:10⁻² m}\" ;",
      "   {{sammPrefix}}numericConversionFactor \"${6:0.01}\"^^{{xsdPrefix}}double .$0"
    ]
  },
  {
    "id": "samm-description",
    "label": "SAMM description",
    "localName": "description",
    "keywords": [ "samm", "summary", "documentation" ],
    "targetPosition": "PREDICATE",
    "body": [
      "{{sammPrefix}}description \"${1}\"@en{{separator}}"
    ]
  },
  {
    "id": "samm-preferred-name",
    "label": "SAMM preferredName",
    "localName": "preferredName",
    "keywords": [ "samm", "title", "label", "display name" ],
    "targetPosition": "PREDICATE",
    "body": [
      "{{sammPrefix}}preferredName \"${1}\"@en{{separator}}"
    ]
  },
  {
    "id": "samm-see",
    "label": "SAMM see",
    "localName": "see",
    "keywords": [ "samm", "reference", "link", "url" ],
    "targetPosition": "PREDICATE",
    "allowMultiple": true,
    "body": [
      "{{sammPrefix}}see <${1:https://example.com/term/}>{{separator}}"
    ]
  },
  {
    "id": "samm-properties",
    "label": "SAMM properties",
    "localName": "properties",
    "keywords": [ "samm" ],
    "targetPosition": "PREDICATE",
    "requiredSubjectTypes": [
