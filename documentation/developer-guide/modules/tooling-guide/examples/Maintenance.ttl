@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:org.eclipse.esmf.examples:1.0.0#> .

# tag::model[]
:Maintenance a samm:Aspect ;
   samm:description "Machine maintenance information"@en ;
   samm:properties ( :lastService ) .

:lastService a samm:Property ;
   samm:characteristic [
      a samm-c:SingleEntity ;
      samm:dataType :ServiceRecord ;
   ] .

:ServiceRecord a samm:Entity ;
   samm:properties (
      :serviceDate
      :technicianName
      :durationOfDeployment
   ) .

:serviceDate a samm:Property ;
   samm:description "When was the maintenance performed"@en ;
   samm:characteristic samm-c:Timestamp .

:technicianName a samm:Property ;
   samm:description "Who performed the maintenance"@en ;
   samm:characteristic samm-c:Text .

:durationOfDeployment a samm:Property ;
   samm:description "How long did the maintenance take"@en ;
   samm:characteristic [
      a samm-c:Duration ;
      samm:dataType xsd:decimal ;
      samm-c:unit unit:hour ;
   ] .
# end::model[]
